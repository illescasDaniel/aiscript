{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from \"jevmem>=0.4.0,<0.5\" jevmem hook session-start",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from \"jevmem>=0.4.0,<0.5\" jevmem hook user-prompt",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
